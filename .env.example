# ─── Build time (inlined into the bundle) ──────────────────────────────────
# Declared as ARG in the Dockerfile; a production build fails when a required
# one is missing or malformed (src/lib/env/build-env.ts).

# Required. In development, a local or staging API (http://localhost:8000 is
# accepted outside production builds) — never production.
NEXT_PUBLIC_API_BASE_URL=https://api.mysugu.com
# The site's public origin: canonical URLs, sitemap, Origin checks.
NEXT_PUBLIC_APP_URL=https://sugu.pro
NEXT_PUBLIC_GOOGLE_CLIENT_ID_WEB=
# Reverb (realtime chat): the backend's public app key, never its secret.
NEXT_PUBLIC_REVERB_APP_KEY=
# Per environment: ws.mysugu.com (production), ws-zk47m.mysugu.com (staging).
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# Optional
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
# Pre-launch wall: rebuild, redeploy and purge the CDN to switch it.
COMING_SOON_ENABLED=false
# Content-Security-Policy enforced instead of Report-Only.
CSP_ENFORCE=false

# ─── Server-only (runtime) ─────────────────────────────────────────────────
# Never prefixed NEXT_PUBLIC_: these stay on the server.

# Shared with Laravel (same value as its SUGU_EDGE_SECRET), at least 32
# characters, e.g. `openssl rand -hex 32`. The server signs the visitor's
# address with it on every call made for a visitor (SSR, /api/backend, proxy),
# so Laravel's per-address limits count each visitor rather than this server.
# Unset: no address is sent and Laravel sees this server for everyone.
SUGU_EDGE_SECRET=

# Proxies whose x-forwarded-for entries are skipped when reading the visitor's
# address, as in Laravel. Defaults to Cloudflare's ranges; TRUSTED_PROXIES_EXTRA
# adds the platform's own proxies (addresses or CIDR ranges, comma separated,
# never "*"). This app must only be reachable through the platform proxy.
TRUSTED_PROXIES=
TRUSTED_PROXIES_EXTRA=
